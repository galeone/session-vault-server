#!/bin/sh
set -e

# Configuration directory for the service environment file
# (SESSION_VAULT_TOKEN_HASHES, ...). Created empty; the admin adds the
# tokens before the first start.
if [ ! -d /etc/session-vault ]; then
	install -d -m 0700 -o root -g root /etc/session-vault
	echo "session-vault: set tokens in /etc/session-vault/session-vault.env" \
		"before the first start (see the README)"
fi

# On upgrade dpkg stops the unit, and debhelper does not start it again
# (it is installed --no-start: a fresh install needs a configuration
# first). A unit that is enabled has been configured, so start it again
# here: try-restart would do nothing, the unit being already stopped.
if [ "$1" = configure ] && [ -n "$2" ] && [ -d /run/systemd/system ]; then
	systemctl daemon-reload >/dev/null || true
	if systemctl --quiet is-enabled session-vault-server.service; then
		deb-systemd-invoke restart session-vault-server.service >/dev/null || true
	fi
fi

#DEBHELPER#

exit 0
