# session-vault-server.service — systemd unit for session-vault-server
#
# The server runs as the dedicated ephemeral user "session-vault"
# (DynamicUser=), so it never runs as root or as a login user and no
# persistent system account has to be created.
#
# The easiest way to install this (binary + unit + /etc/session-vault) is
# the native distro package: run `make install` from the repository root
# (see README.md, "Running under systemd").
#
# Notes:
# - The server is multi-user: configure several tokens in the env file
#   (SESSION_VAULT_TOKENS / SESSION_VAULT_TOKEN_HASHES) and each user only
#   ever sees their own sessions (data/<user>/).
# - Data lives in /var/lib/session-vault/ (StateDirectory, owned by the
#   dynamic user), logs in /var/lib/session-vault/logs/ in addition to the
#   journal: journalctl -u session-vault-server
# - Port and data directory are configurable: see README.md ("Overriding
#   the port or data directory"), e.g. via 'systemctl edit
#   session-vault-server'.

[Unit]
Description=session-vault-server
After=network.target
Wants=network.target

[Service]
Type=simple
# Dedicated ephemeral user/group: allocated dynamically at start,
# released at stop, never in /etc/passwd.
DynamicUser=true
User=session-vault
Group=session-vault

# StateDirectory owns /var/lib/session-vault for the dynamic user
# (symlinked in from /var/lib/private/session-vault).
StateDirectory=session-vault

# Server configuration: tokens, addr, log level, ...
# The defaults below can be overridden with 'systemctl edit
# session-vault-server' (drop-ins are applied after this file, so a later
# Environment= with the same name wins).
EnvironmentFile=-/etc/session-vault/session-vault.env
Environment=SESSION_VAULT_DATA=%S/session-vault
Environment=SESSION_VAULT_LOG_DIR=%S/session-vault/logs

ExecStart=/usr/bin/session-vault-server

Restart=on-failure
RestartSec=2

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
