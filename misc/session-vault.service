# session-vault.service — systemd unit for session-vault-server
#
# The unit refuses to start unless the dedicated "session-vault" system
# user exists (User=/Group= are hardcoded), so the server never runs as
# root or as a login user.
#
# Install and start (see README.md, "Running under systemd"):
#
#   sudo useradd --system --home /var/lib/session-vault --shell /usr/sbin/nologin session-vault
#   sudo install -m 0755 -o root -g root session-vault-server /usr/local/bin/
#   sudo install -d -m 0750 -o root -g session-vault /etc/session-vault
#
#   # server environment: tokens, addr, log level, ...
#   TOKEN=$(openssl rand -hex 32)
#   HASH=$(printf '%s' "$TOKEN" | sha256sum | cut -d' ' -f1)
#   sudo tee /etc/session-vault/session-vault.env >/dev/null <<EOF
#   SESSION_VAULT_TOKEN_HASHES=$HASH:default
#   EOF
#   sudo chown root:session-vault /etc/session-vault/session-vault.env
#   sudo chmod 0640 /etc/session-vault/session-vault.env
#
#   sudo install -m 0644 -o root -g root misc/session-vault.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now session-vault
#
# Notes:
# - The server is multi-user: configure several tokens in the env file
#   (SESSION_VAULT_TOKENS / SESSION_VAULT_TOKEN_HASHES) and each user only
#   ever sees their own sessions (data/<user>/).
# - Data lives in /var/lib/session-vault/ (StateDirectory, owned by
#   session-vault), logs in /var/lib/session-vault/logs/ in addition to the
#   journal: journalctl -u session-vault

[Unit]
Description=session-vault-server
After=network.target
Wants=network.target

[Service]
Type=simple
User=session-vault
Group=session-vault

# Server configuration: tokens, addr, log level, ...
EnvironmentFile=-/etc/session-vault/session-vault.env
Environment=SESSION_VAULT_DATA=%S/
Environment=SESSION_VAULT_LOG_DIR=%S/logs

ExecStart=/usr/local/bin/session-vault-server

Restart=on-failure
RestartSec=2

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
